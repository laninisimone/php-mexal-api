# Connessione e istanza di default
MEXAL_CONN=local
MEXAL_INST=default

# --- Connessione locale (on-premise) ---
MEXAL_URL=https://127.0.0.1
MEXAL_PORT=9004
MEXAL_API_USER=
MEXAL_API_PASSWORD=
# Solo se il server WebAPI è configurato con login=1
MEXAL_SO_USER=
MEXAL_SO_PASSWORD=
# true (default), false, oppure il path di un CA bundle: /etc/ssl/certs/mexal-ca.pem
MEXAL_VERIFY_SSL=true
# Consente http:// — le credenziali Basic viaggerebbero in chiaro. Solo per test.
MEXAL_ALLOW_PLAIN_HTTP=false

# --- Connessione live (Passepartout Cloud) ---
MEXAL_LIVE_DOMAIN=
MEXAL_LIVE_VERIFY_SSL=true

# --- Coordinate gestionali ---
MEXAL_AZIENDA=IMP
MEXAL_SUB_AZIENDA=
MEXAL_ANNO=
MEXAL_MAGAZZINO=1

# --- Trasporto HTTP (opzionali) ---
MEXAL_HTTP_TIMEOUT=60
MEXAL_HTTP_CONNECT_TIMEOUT=10
MEXAL_HTTP_RETRIES=0
MEXAL_HTTP_RETRY_DELAY=250
MEXAL_HTTP_MAX_PAGES=1000
